# Copy this file to .env.local and fill in real values:
#   cp .env.local.example .env.local
# .env.local is already in .gitignore — it will not be committed.

# Gemini — free key at https://aistudio.google.com/apikey (no credit card)
GEMINI_API_KEY=your-key-here

# Supabase — from your project's Settings -> API page
# (supabase.com/dashboard -> your project -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here
